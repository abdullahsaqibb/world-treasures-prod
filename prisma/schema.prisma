// Phase 2 schema. Run reviewed migrations before enabling the admin portal.
generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
 OWNER
 MANAGER
 FULFILLMENT
 CUSTOMER
}
enum ProductStatus {
 DRAFT
 ACTIVE
 ARCHIVED
}
enum OrderStatus {
 PENDING_PAYMENT
 PAID
 PROCESSING
 SHIPPED
 DELIVERED
 CANCELLED
 REFUNDED
}
enum PaymentStatus {
 PENDING
 COMPLETED
 FAILED
 CANCELLED
 REFUNDED
}
model User {
 id String @id @default(cuid())
 email String @unique
 name String?
 role Role @default(CUSTOMER)
 createdAt DateTime @default(now())
 addresses Address[]
 orders Order[]
}
model Address {
 id String @id @default(cuid())
 userId String?
 user User? @relation(fields:[userId],references:[id])
 recipient String
 line1 String
 line2 String?
 cityId String
 city City @relation(fields:[cityId],references:[id])
 postalCode String
 phone String
 createdAt DateTime @default(now())
}
model Category {
 id String @id @default(cuid())
 slug String @unique
 name String
 products Product[]
}
model Product {
 id String @id
 name String
 slug String @unique
 description String?
 categoryId String
 category Category @relation(fields:[categoryId],references:[id])
 status ProductStatus @default(DRAFT)
 verified Boolean @default(false)
 images ProductImage[]
 variants ProductVariant[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model ProductImage {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 url String
 alt String?
 sortOrder Int @default(0)
}
model ProductVariant {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 sku String @unique
 label String
 priceCents Int
 weightGrams Int?
 inventory Inventory?
}
model Inventory {
 id String @id @default(cuid())
 variantId String @unique
 variant ProductVariant @relation(fields:[variantId],references:[id])
 onHand Int @default(0)
 reserved Int @default(0)
}
model City {
 id String @id @default(cuid())
 name String
 province String
 normalizedName String
 active Boolean @default(true)
 aliases String[]
 addresses Address[]
 rates ShippingRate[]
 orders Order[]
 @@unique([province,normalizedName])
}
model ShippingRate {
 id String @id @default(cuid())
 cityId String
 city City @relation(fields:[cityId],references:[id])
 courier String?
 service String @default("STANDARD")
 feeCents Int
 active Boolean @default(true)
 minWeightGrams Int?
 maxWeightGrams Int?
 validFrom DateTime @default(now())
 validUntil DateTime?
 createdAt DateTime @default(now())
 orders Order[]
 @@index([cityId,active])
}
model Order {
 id String @id @default(cuid())
 orderNumber String @unique
 userId String?
 user User? @relation(fields:[userId],references:[id])
 email String
 status OrderStatus @default(PENDING_PAYMENT)
 cityId String
 city City @relation(fields:[cityId],references:[id])
 shippingRateId String?
 shippingRate ShippingRate? @relation(fields:[shippingRateId],references:[id])
 shippingFeeCents Int
 subtotalCents Int
 totalCents Int
 addressSnapshot Json
 items OrderItem[]
 payments Payment[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 sku String
 productName String
 quantity Int
 unitPriceCents Int
 lineTotalCents Int
}
model Payment {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 provider String @default("PAYFAST")
 providerReference String? @unique
 amountCents Int
 status PaymentStatus @default(PENDING)
 events PaymentEvent[]
 createdAt DateTime @default(now())
}
model PaymentEvent {
 id String @id @default(cuid())
 paymentId String
 payment Payment @relation(fields:[paymentId],references:[id])
 eventKey String @unique
 payload Json
 verified Boolean @default(false)
 createdAt DateTime @default(now())
}
